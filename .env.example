# Copy to .env (make init does it) and change every "change-me" value.
BIND_ADDRESS=127.0.0.1

# --- Images: pin exact versions -------------------------------------------------
POSTGRES_IMAGE=postgres:16
TWENTY_IMAGE=twentycrm/twenty:latest
ERPNEXT_IMAGE=frappe/erpnext:v16.35.0
MARIADB_IMAGE=mariadb:11.8

# --- Platform users, created in every source DB ------------------------------
DEBEZIUM_PASSWORD=change-me-debezium
AIRBYTE_READER_PASSWORD=change-me-airbyte

# --- PostgreSQL ------------------------------------------------------------------
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres

# --- Twenty CRM (port 3001: Grafana usually has 3000) ------------------------
TWENTY_PORT=3001
TWENTY_SERVER_URL=http://localhost:3001
# generate with: openssl rand -base64 32
TWENTY_ENCRYPTION_KEY=change-me

# --- ERPNext (port 8082: Airflow usually has 8080) ---------------------------
ERPNEXT_PORT=8082
ERPNEXT_DB_PORT=3307
ERPNEXT_DB_ROOT_PASSWORD=change-me-root
ERPNEXT_ADMIN_PASSWORD=change-me-admin
